# Optional: local preview of the GitHub Pages site.
#
#   cd docs
#   bundle install
#   bundle exec jekyll serve      # then open the "Server address" it prints
#
# GitHub Pages builds the published site itself. The github-pages gem pins the
# same Jekyll version and plugins (including jekyll-remote-theme, which loads
# the Just the Docs theme named in _config.yml), so the preview matches it.

source "https://rubygems.org"

gem "github-pages", group: :jekyll_plugins

# No longer part of the Ruby standard library in recent Ruby versions.
gem "webrick"
gem "csv"
gem "base64"
gem "bigdecimal"
gem "logger"

# Windows and JRuby do not include time-zone data.
platforms :windows, :jruby do
  gem "tzinfo", ">= 1", "< 3"
  gem "tzinfo-data"
end

# Faster file watching on Windows.
gem "wdm", "~> 0.2", platforms: :windows
